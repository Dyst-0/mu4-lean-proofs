import Mu4Comp5.Search

/-!
# mu_4(5): the reduced echelon pairs of GF(4)^3 cover every plane (kernel check)

For every independent pair `u, u'` of 6-bit codes, a witness (`lean/tools/gen_rref3.py`) names an echelon pair of
`rrefPairs3` and its coefficients in `u, u'`; the kernel checks all 4096 entries (`decide +kernel`, four chunks,
about 36 s and 1.3 GB). The meaning is in `Mu4/N5/Keys5.lean`. No `native_decide`. Core Lean only.
-/

set_option autoImplicit false

namespace Mu4.N5
open Mu4 F4 Mu4.Search

/-- `u, u'` independent in GF(4)^3, as a Bool on 6-bit codes. -/
def indep3 (u u' : Nat) : Bool :=
  (List.range 16).all fun ab => ab == 0 || (smulC (coordC ab 0) u ^^^ smulC (coordC ab 1) u') % 64 != 0

/-- The 21 reduced echelon pairs, as a literal (checked against `rrefPairs3` by the kernel). -/
def rref3lit : List (Nat × Nat) := [(1, 4), (1, 16), (1, 20), (1, 36), (1, 52), (4, 16), (5, 16), (9, 16), (13, 16), (17, 4), (17, 20), (17, 36), (17, 52), (33, 4), (33, 20), (33, 36), (33, 52), (49, 4), (49, 20), (49, 36), (49, 52)]

theorem rrefPairs3_eq : rrefPairs3 = rref3lit := by decide +kernel

/-- Witnesses (`lean/tools/gen_rref3.py`): entry `64 u + u'` is `(i << 8) | (ab << 4) | cd` with
`K_i = (a u + b u', c u + d u')` for independent `u, u'`. -/
def rrefTab3 : Nat := 

/-- `a u + b u'` for the pair code `ab`. -/
def lin2u (ab u u' : Nat) : Nat := smulC (coordC ab 0) u ^^^ smulC (coordC ab 1) u'

/-- The witness of the pair `(u, u')` checks. -/
def rrefOK3 (u u' : Nat) : Bool :=
  !indep3 u u' ||
    (let e := (rrefTab3 >>> (16 * (64 * u + u'))) % 65536
     e / 256 < 21 && lin2u ((e / 16) % 16) u u' == (rref3lit.getD (e / 256) (0, 0)).1 &&
       lin2u (e % 16) u u' == (rref3lit.getD (e / 256) (0, 0)).2)

theorem rref_cover3_1 : (List.range' 0 16).all (fun u => (List.range 64).all (rrefOK3 u)) = true := by
  decide +kernel
theorem rref_cover3_2 : (List.range' 16 16).all (fun u => (List.range 64).all (rrefOK3 u)) = true := by
  decide +kernel
theorem rref_cover3_3 : (List.range' 32 16).all (fun u => (List.range 64).all (rrefOK3 u)) = true := by
  decide +kernel
theorem rref_cover3_4 : (List.range' 48 16).all (fun u => (List.range 64).all (rrefOK3 u)) = true := by
  decide +kernel

end Mu4.N5
