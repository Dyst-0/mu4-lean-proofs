import Mu4.Code
import Mathlib.Tactic.Ring
import Mathlib.Tactic.FinCases
import Mathlib.Data.Nat.Bitwise

/-!
# GF(4^6) is a field

`timesT` (multiplication by `t`) and `mulK` (multiplication, Horner form) on codes, with their
correctness; then the `Field` instance. The inverse of a nonzero element is read from a table
(`invTable`, generated by `lean/tools/gen_inv.py`), and the kernel checks `x * invC x = 1` for
all 4095 nonzero codes (four `decide +kernel` chunks, about 45 s in all).
-/

namespace Mu4
open F4

/-- The element `t` of GF(4^6). -/
def tG : GF := ⟨pw 1⟩

lemma mul_tG_v (a : GF) (l : Fin 6) :
    (a * tG).v l = ∑ i : Fin 6, a.v i * T i 1 l := by
  rw [GF.mul_v]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Fin.sum_univ_six]
  simp [tG, pw]

lemma testBit_4095 (l : Nat) (hl : l < 6) :
    (4095 : Nat).testBit (2 * l) = true ∧ (4095 : Nat).testBit (2 * l + 1) = true := by
  revert l; decide

lemma coordC_shl2 (v l : Nat) (hl : l < 6) :
    coordC ((v <<< 2) &&& 4095) l = if l = 0 then 0 else coordC v (l - 1) := by
  obtain ⟨h0, h1⟩ := testBit_4095 l hl
  simp only [coordC, Nat.testBit_and, Nat.testBit_shiftLeft, h0, h1, Bool.and_true]
  rcases l with _ | j
  · simp [F4.ofBits]; rfl
  · have e0 : 2 * (j + 1) - 2 = 2 * j := by omega
    have e1 : 2 * (j + 1) + 1 - 2 = 2 * j + 1 := by omega
    simp [e0, e1, show 2 ≤ 2 * (j + 1) by omega, show 2 ≤ 2 * (j + 1) + 1 by omega]

lemma T_col1 : ∀ i l : Fin 6,
    T i 1 l = if i.val + 1 = l.val then 1 else if i.val = 5 then ![w, 1, 1, 0, 0, 0] l else 0 := by
  decide

lemma coordC_22 : ∀ l : Fin 6, coordC 22 l.val = ![w, 1, 1, 0, 0, 0] l := by decide

lemma decode_timesT (v : Nat) : decode (timesT v) = decode v * tG := by
  ext l
  rw [mul_tG_v]
  simp only [decode_v, timesT, coordC_xor, coordC_shl2 v l.val (by omega),
    coordC_smulC _ _ _ (show l.val < 32 by omega), coordC_22, T_col1, Fin.sum_univ_six]
  fin_cases l <;> simp

lemma tG_pow_v : ∀ l k : Fin 6, (tG ^ l.val).v k = pw ⟨l.val, by omega⟩ k := by decide +kernel

lemma tG_pow (l : Fin 6) : tG ^ l.val = ⟨pw ⟨l.val, by omega⟩⟩ := GF.ext (funext (tG_pow_v l))

lemma decode_eq_sum (x : Nat) : decode x = ∑ l : Fin 6, coordC x l • tG ^ l.val := by
  ext k
  rw [GF.v_sum]
  simp only [GF.smul_v, tG_pow, Pi.smul_apply, smul_eq_mul, decode_v, Fin.sum_univ_six]
  fin_cases k <;> simp [pw]

lemma decode_mulK (x y : Nat) : decode (mulK x y) = decode x * decode y := by
  rw [decode_eq_sum x]
  simp only [mulK, decode_xor, decode_smulC, decode_timesT, Fin.sum_univ_six, Algebra.smul_def]
  simp only [Fin.val_zero, Fin.val_one, Fin.val_two, pow_zero, pow_one]
  norm_num
  ring

theorem invC_ok1 : (List.range' 1 1024).all (fun x => mulK x (invC x) == 1) = true := by
  decide +kernel
theorem invC_ok2 : (List.range' 1025 1024).all (fun x => mulK x (invC x) == 1) = true := by
  decide +kernel
theorem invC_ok3 : (List.range' 2049 1024).all (fun x => mulK x (invC x) == 1) = true := by
  decide +kernel
theorem invC_ok4 : (List.range' 3073 1023).all (fun x => mulK x (invC x) == 1) = true := by
  decide +kernel

lemma mulK_invC (x : Nat) (h1 : 1 ≤ x) (h2 : x < 4096) : mulK x (invC x) = 1 := by
  have key : ∀ (s n : Nat), (List.range' s n).all (fun x => mulK x (invC x) == 1) = true →
      s ≤ x → x < s + n → mulK x (invC x) = 1 := by
    intro s n h hs hn
    have := List.all_eq_true.mp h x (List.mem_range'_1.mpr ⟨hs, hn⟩)
    simpa using this
  by_cases a : x < 1025
  · exact key 1 1024 invC_ok1 h1 (by omega)
  by_cases b : x < 2049
  · exact key 1025 1024 invC_ok2 (by omega) (by omega)
  by_cases c : x < 3073
  · exact key 2049 1024 invC_ok3 (by omega) (by omega)
  · exact key 3073 1023 invC_ok4 (by omega) (by omega)

end Mu4
