import Mu4.Normal.Frobenius
import Mu4.Normal.CoverCheck1
import Mu4.Normal.CoverCheck2

/-!
# The coverage facts C1, C2 (`audit/PROOF.md`), checked by the kernel

Every 2-dim subspace of `A = GF(4^6)` is `x · span(1, z)` with `z ∉ GF(4)`. For each code `z` (`4 ≤ z < 4096`) the
certificate tables of `Mu4/Normal/CoverData.lean` (generated by `lean/tools/gen_cover.py`) give
* C1: `k < 10`, `s < 12`, `(a, b) ≠ 0`, `c`, `d` with `(a + b z) · σ^s(p1_k) = c + d z`, where `P_k = span(1, p1_k)` is
  the `k`-th pencil representative of `pList`;
* C2: `j < 69`, `(a, b) ≠ 0`, `c`, `d` with `(a + b z) · s1_j = c + d z`, where `S_j = span(1, s1_j)` is the
  `j`-th class representative of `sList`.
The kernel checks all 4092 entries of each table (`decide +kernel`, in chunks of 1023), and `σ^s(p1_k)` from its
own table (`frobTab`). `cover1` and `cover2` state the result in the field. No `native_decide`.
-/

set_option autoImplicit false

namespace Mu4.Normal
open Mu4 F4 Mu4.Lower Mu4.Search

lemma all_range'_of {f : Nat → Bool} (h1 : (List.range' 4 1023).all f = true)
    (h2 : (List.range' 1027 1023).all f = true) (h3 : (List.range' 2050 1023).all f = true)
    (h4 : (List.range' 3073 1023).all f = true) (x : Nat) (hx4 : 4 ≤ x) (hx : x < 4096) :
    f x = true := by
  have key : ∀ (s n : Nat), (List.range' s n).all f = true → s ≤ x → x < s + n → f x = true := by
    intro s n h hs hn
    exact List.all_eq_true.mp h x (List.mem_range'_1.mpr ⟨hs, hn⟩)
  by_cases a : x < 1027
  · exact key 4 1023 h1 hx4 (by omega)
  by_cases b : x < 2050
  · exact key 1027 1023 h2 (by omega) (by omega)
  by_cases c : x < 3073
  · exact key 2050 1023 h3 (by omega) (by omega)
  · exact key 3073 1023 h4 (by omega) (by omega)

lemma c1Ok_all (x : Nat) (hx4 : 4 ≤ x) (hx : x < 4096) : c1Ok x = true :=
  all_range'_of c1_ok1 c1_ok2 c1_ok3 c1_ok4 x hx4 hx

lemma c2Ok_all (x : Nat) (hx4 : 4 ≤ x) (hx : x < 4096) : c2Ok x = true :=
  all_range'_of c2_ok1 c2_ok2 c2_ok3 c2_ok4 x hx4 hx

/-! ### Decoding -/

lemma decode_lin2 (ab z : Nat) : decode (lin2 ab z) = coordC ab 0 • (1 : GF) + coordC ab 1 • decode z := by
  rw [lin2, decode_xor, decode_smulC, decode_smulC, decode_one]

lemma ab_ne : ∀ ab < 16, ab ≠ 0 → coordC ab 0 ≠ 0 ∨ coordC ab 1 ≠ 0 := by decide

lemma ftab_spec (k : Nat) (hk : k < 10) :
    ftab k 0 = (pList.getD k (0, 0)).2 ∧ ∀ s < 11, ftab k (s + 1) = mulK (ftab k s) (ftab k s) := by
  have h := ftab_ok
  simp only [ftabOk, List.all_eq_true, List.mem_range, Bool.and_eq_true, beq_iff_eq] at h
  exact ⟨(h k hk).1, (h k hk).2⟩

lemma decode_ftab (k : Nat) (hk : k < 10) (s : Nat) (hs : s < 12) :
    decode (ftab k s) = frob^[s] (decode (pList.getD k (0, 0)).2) := by
  induction s with
  | zero => rw [(ftab_spec k hk).1]; rfl
  | succ s ih =>
    rw [(ftab_spec k hk).2 s (by omega), decode_mulK, ih (by omega), Function.iterate_succ_apply']
    rfl

/-- The codes `0, 1, 2, 3` are the elements of `GF(4) · 1`. -/
lemma decode_small : ∀ x < 4, ∀ l : Fin 6, coordC x l.val = (coordC x 0 • (1 : GF)).v l := by
  decide

lemma code_ge_four {z : GF} (hz : ∀ c : F4, z ≠ c • 1) : 4 ≤ encode z := by
  by_contra h
  push_neg at h
  apply hz (coordC (encode z) 0)
  rw [← decode_encode z]
  ext l
  rw [decode_v, decode_encode, ← decode_v, decode_encode]
  have := decode_small (encode z) h l
  rw [← this, ← decode_v, decode_encode]

/-- C1 in the field. -/
theorem cover1 (z : GF) (hz : ∀ c : F4, z ≠ c • 1) :
    ∃ k < 10, ∃ s < 12, ∃ a b c d : F4, (a ≠ 0 ∨ b ≠ 0) ∧
      (a • 1 + b • z) * frob^[s] (decode (pList.getD k (0, 0)).2) = c • 1 + d • z := by
  have h := c1Ok_all (encode z) (code_ge_four hz) (encode_lt z)
  unfold c1Ok at h
  generalize (c1Tab >>> (16 * encode z)) % 65536 = e at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq, beq_iff_eq] at h
  obtain ⟨⟨⟨hk, hs⟩, hab⟩, heq⟩ := h
  refine ⟨e / 4096, hk, e / 256 % 16, hs, coordC (e / 16 % 16) 0, coordC (e / 16 % 16) 1,
    coordC (e % 16) 0, coordC (e % 16) 1, ab_ne _ (Nat.mod_lt _ (by norm_num)) hab, ?_⟩
  have := congrArg decode heq
  rw [decode_mulK, decode_lin2, decode_lin2, decode_ftab _ hk _ hs, decode_encode] at this
  exact this

/-- C2 in the field. -/
theorem cover2 (z : GF) (hz : ∀ c : F4, z ≠ c • 1) :
    ∃ j < 69, ∃ a b c d : F4, (a ≠ 0 ∨ b ≠ 0) ∧
      (a • 1 + b • z) * decode (sList.getD j (0, 0)).2 = c • 1 + d • z := by
  have h := c2Ok_all (encode z) (code_ge_four hz) (encode_lt z)
  unfold c2Ok at h
  generalize (c2Tab >>> (16 * encode z)) % 65536 = e at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, bne_iff_ne, ne_eq, beq_iff_eq] at h
  obtain ⟨⟨hj, hab⟩, heq⟩ := h
  refine ⟨e / 256, hj, coordC (e / 16 % 16) 0, coordC (e / 16 % 16) 1,
    coordC (e % 16) 0, coordC (e % 16) 1, ab_ne _ (Nat.mod_lt _ (by norm_num)) hab, ?_⟩
  have := congrArg decode heq
  rw [decode_mulK, decode_lin2, decode_lin2, decode_encode] at this
  exact this

/-! ### The representatives -/

lemma pList_spec : ∀ k < 10, (pList.getD k (0, 0)).1 = 1 ∧ 4 ≤ (pList.getD k (0, 0)).2 ∧
    (pList.getD k (0, 0)).2 < 4096 := by decide

lemma sList_spec : ∀ j < 69, (sList.getD j (0, 0)).1 = 1 ∧ 4 ≤ (sList.getD j (0, 0)).2 ∧
    (sList.getD j (0, 0)).2 < 4096 := by decide

lemma pList_mem (k : Nat) (hk : k < 10) : pList.getD k (0, 0) ∈ pList := by
  rw [List.getD_eq_getElem _ _ (by simp [pList]; omega)]; exact List.getElem_mem _

lemma sList_mem (j : Nat) (hj : j < 69) : sList.getD j (0, 0) ∈ sList := by
  rw [List.getD_eq_getElem _ _ (by simp [sList]; omega)]; exact List.getElem_mem _

/-- A code below `4096` whose coordinates `1..5` vanish is below `4`. -/
lemma lt_four_of_coord {x : Nat} (hx : x < 4096) (hc : ∀ l, 1 ≤ l → l < 6 → coordC x l = 0) :
    x < 4 := by
  have key : ∀ a b : Bool, F4.ofBits a b = 0 → a = false ∧ b = false := by decide
  have hb : ∀ i, 2 ≤ i → x.testBit i = false := by
    intro i hi
    by_cases h12 : i < 12
    · have hcl := hc (i / 2) (by omega) (by omega)
      simp only [coordC] at hcl
      obtain ⟨h0, h1⟩ := key _ _ hcl
      rcases Nat.even_or_odd i with ⟨k, hk⟩ | ⟨k, hk⟩
      · have : i = 2 * (i / 2) := by omega
        rw [this]; exact h0
      · have : i = 2 * (i / 2) + 1 := by omega
        rw [this]; exact h1
    · apply Nat.testBit_eq_false_of_lt
      calc x < 2 ^ 12 := by norm_num; exact hx
        _ ≤ 2 ^ i := Nat.pow_le_pow_right (by norm_num) (by omega)
  have := Nat.lt_pow_two_of_testBit x (n := 2) (fun i hi => hb i hi)
  simpa using this

lemma GF_eq_of_add_eq_zero {x y : GF} (h : x + y = 0) : x = y := by
  calc x = x + (y + y) := by rw [GF_add_self', add_zero]
    _ = (x + y) + y := by rw [add_assoc]
    _ = y := by rw [h, zero_add]

/-- `1` and `decode x` are independent for a code `x ∉ {0, 1, 2, 3}`. -/
lemma indep_one_decode {x : Nat} (hx4 : 4 ≤ x) (hx : x < 4096) :
    LinearIndependent F4 ![(1 : GF), decode x] := by
  rw [LinearIndependent.pair_iff]
  intro s t hst
  by_cases ht : t = 0
  · subst ht
    simp only [zero_smul, add_zero] at hst
    refine ⟨?_, rfl⟩
    have := congrArg (fun y : GF => y.v 0) hst
    simpa [GF.one_v, pw] using this
  · exfalso
    have h1 : t • decode x = s • (1 : GF) := (GF_eq_of_add_eq_zero (by rw [add_comm]; exact hst))
    have hdx : decode x = (t⁻¹ * s) • (1 : GF) := by
      calc decode x = t⁻¹ • (t • decode x) := by rw [smul_smul, inv_mul_cancel₀ ht, one_smul]
        _ = (t⁻¹ * s) • (1 : GF) := by rw [h1, smul_smul]
    have hc : ∀ l : Nat, 1 ≤ l → l < 6 → coordC x l = 0 := by
      intro l hl1 hl6
      have := congrArg (fun y : GF => y.v ⟨l, hl6⟩) hdx
      simp only [decode_v, GF.smul_v, GF.one_v, Pi.smul_apply, smul_eq_mul] at this
      rw [this]
      interval_cases l <;> simp [pw]
    have := lt_four_of_coord hx hc
    omega

end Mu4.Normal
